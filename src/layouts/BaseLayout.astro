---
import en from '../../messages/en.json'
import ja from '../../messages/ja.json'
const { locale, page = 'home', title, description, canonicalPath = '', noindex = false } = Astro.props
const messages = locale === 'ja' ? ja : en
const metaTitle = title ?? messages.Metadata.title
const metaDescription = description ?? messages.Metadata.description
const base = 'https://ricky.burg.in'
const path = `/${locale}${canonicalPath || '/'}`
const preview = import.meta.env.PUBLIC_SITE_MODE !== 'production'
const canonicalUrl = preview ? undefined : `${base}${path}`
const query = Astro.url.search
const switchPath = `/${locale === 'en' ? 'ja' : 'en'}${canonicalPath || '/'}${query}`
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ec" />
    <title>{metaTitle}</title>
    <meta name="description" content={metaDescription} />
    {!preview && !noindex && <link rel="canonical" href={canonicalUrl} />}
    {!preview && !noindex && <link rel="alternate" hreflang="en" href={`${base}/en${canonicalPath || '/'}`} />}
    {!preview && !noindex && <link rel="alternate" hreflang="ja" href={`${base}/ja${canonicalPath || '/'}`} />}
    {!preview && !noindex && <link rel="alternate" hreflang="x-default" href={`${base}/en${canonicalPath || '/'}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={messages.Metadata.site_name} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    {!preview && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:image" content={`${preview ? '' : base}/images/ricky/ricky.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    {(preview || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <script is:inline>
      document.documentElement.classList.add('js');
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch {}
      const dark = saved ? saved === 'dark' : window.matchMedia?.('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    </script>
    <link rel="stylesheet" href="/styles/site.css" />
    <script>
      import { initTheme, initLanguageSwitch } from '../scripts/site.js'
      initTheme()
      initLanguageSwitch()
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'ja' ? '本文へ' : 'Skip to content'}</a>
    <header class="site-header"><div class="header-inner">
      <a class="brand" href={`/${locale}/`} aria-label={locale === 'ja' ? 'Ricky Burgin — ホーム' : 'Ricky Burgin — home'}><span class="brand-mark" aria-hidden="true">rb.</span><span>Ricky Burgin</span></a>
      <nav id="primary-nav" class="primary-nav" aria-label={locale === 'ja' ? 'メインナビゲーション' : 'Main navigation'}>
        <a href={`/${locale}/`} aria-current={!canonicalPath && !noindex ? 'page' : undefined}>{messages.UI.overview}</a>
        <a href={`/${locale}/work/`} aria-current={page === 'work' ? 'page' : undefined}>{messages.UI.experience}</a>
        <a href={`/${locale}/contact/`} aria-current={page === 'contact' ? 'page' : undefined}>{messages.Navbar.contact}</a>
      </nav>
      <div class="header-tools">
        <a class="language-link" href={switchPath} data-language-switch lang={locale === 'en' ? 'ja' : 'en'} aria-label={locale === 'en' ? ja.Navbar.switch_to_japanese : en.Navbar.switch_to_english}>{locale === 'en' ? '日本語' : 'English'}</a>
        <button class="theme-toggle" type="button" aria-label={messages.Navbar.switch_to_dark} data-light-label={messages.Navbar.switch_to_light} data-dark-label={messages.Navbar.switch_to_dark}>
          <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.5 14a8.5 8.5 0 0 1-10.5-10.5A8.5 8.5 0 1 0 20.5 14Z"/></svg>
        </button>
      </div>
    </div></header>
    <main id="main" class:list={['container', `page-${page}`]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer"><div class="footer-inner"><a class="footer-name" href={`/${locale}/`}>Ricky Burgin<span>{messages.UI.footer_note}</span></a><div class="footer-links"><a href="https://github.com/einichi" rel="me">GitHub <span aria-hidden="true">↗</span></a><a href="https://www.linkedin.com/in/rickyburgin/">LinkedIn <span aria-hidden="true">↗</span></a><a href="/sitemap.xml">Sitemap</a></div><span class="copyright">© {new Date().getFullYear()}</span></div></footer>
  </body>
</html>
