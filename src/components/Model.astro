---
const { locale } = Astro.props
---
<section class="model-hero" aria-label={locale === 'ja' ? 'リッキーの3Dポートレート' : '3D portrait of Ricky'}>
  <div class="model-stage">
    <img data-model-fallback src="/images/ricky/ricky.jpg" alt={locale === 'ja' ? 'リッキー・バーギンの写真' : 'Portrait of Ricky Burgin'} width="144" height="144" fetchpriority="high" />
    <p data-model-status role="status" class="model-status">{locale === 'ja' ? '3Dポートレートを読み込み中…' : 'Loading 3D portrait…'}</p>
    <button type="button" class="button secondary model-retry" data-model-retry hidden>{locale === 'ja' ? '再試行' : 'Retry'}</button>
    <div data-model-host></div>
  </div>
  <div class="model-controls">
    <button class="model-turn" type="button" data-model-turn hidden>{locale === 'ja' ? '向きを変える' : 'Turn portrait'}<span aria-hidden="true">↻</span></button>
  </div>
  <noscript><style>[data-model-status] { display: none; }</style></noscript>
</section>
<script>
  import { enableLazyModel } from '../scripts/lazy-model.js'
  enableLazyModel()
</script>
