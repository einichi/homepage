---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Model from '../../components/Model.astro'
import en from '../../../messages/en.json'
import ja from '../../../messages/ja.json'
import { SKILLS, LANGUAGES, INTERESTS } from '../../../lib/profile-data.js'
export function getStaticPaths() { return [{ params: { locale: 'en' } }, { params: { locale: 'ja' } }] }
const locale = Astro.params.locale === 'ja' ? 'ja' : 'en'
const m = locale === 'ja' ? ja : en
const u = m.UI
const selected = ['marigold_sre', 'cheetah_security', 'cheetah_it'] as const
---
<BaseLayout locale={locale}>
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow"><span class="small-rule" aria-hidden="true"></span>{u.intro_label}</p>
      <h1 id="intro-title">{u.hero_line_one}<br /><em>{u.hero_line_two}</em></h1>
      <p class="intro-description">{u.hero_description}</p>
      <div class="hero-actions"><a class="button" href={`/${locale}/work/`}>{u.explore_work}<span aria-hidden="true">↗</span></a><a class="text-link" href={`/${locale}/contact/`}>{u.get_in_touch}<span aria-hidden="true">→</span></a></div>
      <div class="hero-footnote"><span class="location-dot" aria-hidden="true"></span>{u.location}</div>
    </div>
    <aside class="identity-card" aria-label={u.profile_label}>
      <div class="identity-card-top"><span class="mono">RB / 01</span><span class="mono">{u.based_in}</span></div>
      <div class="identity-art" aria-hidden="true"><svg viewBox="0 0 320 220" fill="none"><path d="M40 110H280M160 20V200M70 35L250 185M70 185L250 35"/><circle cx="160" cy="110" r="84"/><circle cx="160" cy="110" r="52"/><rect x="146" y="96" width="28" height="28" rx="14"/><circle cx="76" cy="110" r="6"/><circle cx="244" cy="110" r="6"/><circle cx="160" cy="26" r="6"/><circle cx="160" cy="194" r="6"/></svg><span class="art-caption mono">{u.art_caption}</span></div>
      <div class="identity-person"><img src="/images/ricky/ricky.jpg" width="64" height="64" alt={u.portrait_alt} fetchpriority="high" /><div><strong>{m.HomePage.title}</strong><span>{u.person_role}</span></div></div>
      <div class="identity-card-bottom"><span>{u.identity_note}</span></div>
    </aside>
  </section>
  <div class="expertise-strip" aria-label={u.focus_label}><span>{u.focus_infra}</span><span>{u.focus_security}</span><span>{u.focus_people}</span><span>{u.focus_languages}</span></div>
  <section class="editorial-section" aria-labelledby="experience-title">
    <div class="section-heading"><div><p class="eyebrow">01 / {u.experience}</p><h2 id="experience-title">{u.selected_work}</h2></div><a class="text-link" href={`/${locale}/work/`}>{u.full_experience}<span aria-hidden="true">→</span></a></div>
    <div class="selected-work">
      {selected.map(key => <a class="work-row" href={`/${locale}/work/#${key}`}><span class="work-date mono">{m.Work.jobs[key].date}</span><div class="work-row-copy"><span class="company-label">{m.Work.jobs[key].company}</span><h3>{m.Work.jobs[key].title}</h3><p>{u.job_summaries[key]}</p></div><span class="row-arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>
  <section class="editorial-section about-section" aria-labelledby="about-title">
    <div class="section-intro"><p class="eyebrow">02 / {u.about_label}</p><h2 id="about-title">{u.about_heading}</h2><span class="section-doodle" aria-hidden="true">↳</span></div>
    <div class="about-copy"><p class="large-copy">{m.HomePage.about.intro}</p><p>{m.HomePage.about.p1}</p><p>{m.HomePage.about.p2}</p><dl class="language-list">{LANGUAGES.map(item => <div><dt>{m.Profile.Languages[item.nameKey as keyof typeof m.Profile.Languages]}</dt><dd>{m.Profile.Levels[item.levelKey as keyof typeof m.Profile.Levels]}</dd></div>)}</dl></div>
  </section>
  <section class="editorial-section" aria-labelledby="toolkit-title">
    <div class="section-heading"><div><p class="eyebrow">03 / {u.toolkit_label}</p><h2 id="toolkit-title">{u.toolkit_heading}</h2></div><p class="section-note">{u.toolkit_note}</p></div>
    <div class="toolkit-grid">{Object.entries(SKILLS).map(([key, items]) => <div class="toolkit-group"><h3><span class="toolkit-symbol" aria-hidden="true">{key === 'infrastructure' ? '⌘' : '{ }'}</span>{m.HomePage.headers[key === 'infrastructure' ? 'infrastructure' : 'programming']}</h3><ul class="skill-list">{items.map(skill => <li>{skill.name}</li>)}</ul></div>)}</div>
  </section>
  <section class="editorial-section personal-section" aria-labelledby="personal-title">
    <div><p class="eyebrow">04 / {u.personal_label}</p><h2 id="personal-title">{u.personal_heading}</h2></div><div><ul class="interest-list">{INTERESTS.map(item => <li>{m.Profile.Interests[item.nameKey as keyof typeof m.Profile.Interests]}</li>)}</ul><details class="portrait-playground"><summary>{u.model_disclosure}<span aria-hidden="true">+</span></summary><Model locale={locale} /></details></div>
  </section>
  <section class="contact-banner"><p class="eyebrow">{u.contact_label}</p><h2>{u.contact_heading}</h2><a class="button" href={`/${locale}/contact/`}>{u.get_in_touch}<span aria-hidden="true">↗</span></a></section>
</BaseLayout>
