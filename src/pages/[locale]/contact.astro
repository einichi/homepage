---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ContactForm from '../../components/ContactForm'
import en from '../../../messages/en.json'
import ja from '../../../messages/ja.json'
export function getStaticPaths() { return [{ params: { locale: 'en' } }, { params: { locale: 'ja' } }] }
const locale = Astro.params.locale === 'ja' ? 'ja' : 'en'
const m = locale === 'ja' ? ja : en
---
<BaseLayout locale={locale} page="contact" title={m.Metadata.contact_title} description={m.Metadata.contact_description} canonicalPath="/contact/">
  <section class="content-section contact-section">
    <h1>{m.Contact.title}</h1>
    <ContactForm client:load locale={locale} messages={m.Contact} isHireMe={Astro.url.searchParams.has('hireme')} sitekey={import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? ''} />
  </section>
</BaseLayout>
