---
import BaseLayout from '../../layouts/BaseLayout.astro'
import en from '../../../messages/en.json'
import ja from '../../../messages/ja.json'
export function getStaticPaths() { return [{ params: { locale: 'en' } }, { params: { locale: 'ja' } }] }
const locale = Astro.params.locale === 'ja' ? 'ja' : 'en'
const m = locale === 'ja' ? ja.NotFound : en.NotFound
---
<BaseLayout locale={locale} page="not-found" title={m.title} description={m.body} noindex>
  <section class="not-found"><p class="eyebrow">404 / {locale === 'ja' ? '道に迷ったようです' : 'A small detour'}</p><h1>{m.title}</h1><p class="large-copy">{m.body}</p><p>{m.body_action}</p><div class="hero-actions"><a class="button" href={`/${locale}/`}>{m.back_cta}<span aria-hidden="true">↗</span></a><a class="text-link" href={`/${locale}/contact/`}>{m.contact_cta}<span aria-hidden="true">→</span></a></div></section>
</BaseLayout>
