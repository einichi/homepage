---
import BaseLayout from '../../layouts/BaseLayout.astro'
import en from '../../../messages/en.json'
import ja from '../../../messages/ja.json'
export function getStaticPaths() { return [{ params: { locale: 'en' } }, { params: { locale: 'ja' } }] }
const locale = Astro.params.locale === 'ja' ? 'ja' : 'en'
const m = locale === 'ja' ? ja : en
const u = m.UI
const jobs = ['locationmind', 'marigold_sre', 'cheetah_security', 'cheetah_it', 'cheetah_devops', 'experian_uk', 'appliansys', 'exoware'] as const
const jobSummaries: Partial<Record<keyof typeof m.Work.jobs, string>> = u.job_summaries
---
<BaseLayout locale={locale} page="work" title={m.Metadata.work_title} description={m.Metadata.work_description} canonicalPath="/work/">
  <section class="page-intro"><h1>{u.work_heading}</h1><div class="page-intro-bottom"><p>{u.work_intro}</p><a class="text-link" href={`/${locale}/contact/?hireme`}>{u.discuss_role}<span aria-hidden="true">↗</span></a></div></section>
  <section class="career-list" aria-label={m.Work.title}>
    {jobs.map((key, index) => {
      const job = m.Work.jobs[key]
      const summary = jobSummaries[key]
      return (
        <article class="career-entry" id={key}>
          <div class="career-meta">
            <span class="mono">{job.date}</span>
            {index === 0 && <span class="current-label">{u.current_role}</span>}
          </div>
          <div class="career-copy">
            <p class="company-label">{job.company}</p>
            <h2>{job.title}</h2>
            <p class="career-summary">{summary ?? job.details}</p>
            {summary && <details class="role-details"><summary>{u.role_details}<span aria-hidden="true">+</span></summary><p>{job.details}</p></details>}
          </div>
        </article>
      )
    })}
  </section>
  <section class="contact-banner"><p class="eyebrow">{u.contact_label}</p><h2>{u.work_cta}</h2><a class="button" href={`/${locale}/contact/?hireme`}>{u.discuss_role}<span aria-hidden="true">↗</span></a></section>
</BaseLayout>
