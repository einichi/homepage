{
  "name": "Homepage Dev Env",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "updateContentCommand": "npm ci && npm run build",
  "postAttachCommand": {
    "server": "npm run dev"
  },

  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"]
    },
    "codespaces": {
      "openFiles": ["src/pages/[locale]/index.astro", "src/pages/[locale]/work.astro"]
    }
  },
  "portsAttributes": {
    "8787": {
      "label": "Homepage",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8787]
}
